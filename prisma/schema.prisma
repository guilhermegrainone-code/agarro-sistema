generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  // preço em centavos (evita erros de arredondamento com float)
  priceCents  Int
  // custo unitário em centavos — usado para calcular o lucro nas vendas
  costCents   Int       @default(0)
  // peso em kg e dimensões em cm — usados no cálculo de frete
  weightKg    Float     @default(0.3)
  heightCm    Float     @default(4)
  widthCm     Float     @default(25)
  lengthCm    Float     @default(20)
  images      String[]  @default([])
  active      Boolean   @default(true)
  variants    Variant[]
  orderItems  OrderItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Variant {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  size      String
  color     String   @default("")
  stock     Int      @default(0)
  sku       String?
  orderItems OrderItem[]
  movements  StockMovement[]

  @@unique([productId, size, color])
}

model Order {
  id                String      @id @default(cuid())
  status            OrderStatus @default(PENDING)
  // de onde veio a venda: site, loja física, WhatsApp...
  channel           OrderChannel @default(SITE)
  // forma de pagamento (texto livre: Pix, Dinheiro, Cartão de crédito...)
  paymentMethod     String      @default("")
  customerName      String
  customerEmail     String      @default("")
  customerPhone     String      @default("")
  street            String      @default("")
  number            String      @default("")
  complement        String      @default("")
  neighborhood      String      @default("")
  city              String      @default("")
  state             String      @default("")
  cep               String      @default("")
  subtotalCents     Int
  discountCents     Int         @default(0)
  shippingCents     Int
  totalCents        Int
  shippingService   String      @default("")
  shippingDays      Int?
  note              String      @default("")
  mpPreferenceId    String?
  mpPaymentId       String?
  paidAt            DateTime?
  items             OrderItem[]
  movements         StockMovement[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  variant    Variant? @relation(fields: [variantId], references: [id])
  variantId  String?
  name       String
  size       String   @default("")
  color      String   @default("")
  priceCents Int
  // custo unitário no momento da venda (para o lucro não mudar se o custo for editado depois)
  costCents  Int      @default(0)
  quantity   Int
}

// Histórico de tudo que entra e sai do estoque. O campo `stock` da variação
// é sempre o saldo atual; cada linha aqui é o "extrato".
model StockMovement {
  id        String       @id @default(cuid())
  variant   Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  type      MovementType
  // positivo = entrou no estoque, negativo = saiu
  quantity  Int
  note      String       @default("")
  createdAt DateTime     @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

model Subscriber {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum OrderChannel {
  SITE
  LOJA_FISICA
  WHATSAPP
  INSTAGRAM
  OUTRO
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  DEVOLUCAO
}
