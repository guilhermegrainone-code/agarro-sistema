# Banco de dados Postgres. IMPORTANTE: use a MESMA DATABASE_URL do site (loja-fitness)
# — é isso que faz as vendas do site aparecerem aqui automaticamente.
DATABASE_URL="postgresql://usuario:senha@host:5432/loja_fitness?sslmode=require"

# Login do sistema (você define aqui)
ADMIN_EMAIL="ela@exemplo.com"
ADMIN_PASSWORD="escolha-uma-senha-forte"

# Chave usada para assinar o cookie de sessão — gere uma string aleatória longa
# (ex: rode `openssl rand -hex 32` no terminal)
SESSION_SECRET="troque-por-uma-string-aleatoria-bem-longa"

# Opcional: endereço do site, para o link "Ver a loja" no menu (deixe vazio enquanto o site não estiver no ar)
NEXT_PUBLIC_SITE_URL=""

# Opcional: upload de fotos dos produtos (Vercel Blob). Sem isso o sistema funciona normalmente,
# só não dá para enviar fotos pelo cadastro de produto.
BLOB_READ_WRITE_TOKEN=""
